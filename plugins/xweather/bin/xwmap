#!/bin/sh
# Xweather Raster Maps image helper. See skills/raster-maps/scripts/xwmap.py for usage.
# Credentials come from XWEATHER_CLIENT_ID / XWEATHER_CLIENT_SECRET in the environment.
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
exec python3 "$here/../skills/raster-maps/scripts/xwmap.py" "$@"
